{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "anonymous-denied",
      "description": "Anonymous users cannot call protected APIs",
      "actor": {
        "state": "anonymous",
        "role": "guest",
        "permissions": []
      },
      "target": {
        "workspaceId": "workspace-a",
        "baseId": "base-a",
        "resourceType": "record"
      },
      "operation": "records:read",
      "requiredPermission": "records:read",
      "frontendVisible": false,
      "expected": {
        "status": 401,
        "failureClass": "authentication"
      }
    },
    {
      "id": "authenticated-unauthorized-denied",
      "description": "Authenticated users without permission receive authorization denial",
      "actor": {
        "state": "active",
        "role": "viewer",
        "permissions": ["records:read"]
      },
      "target": {
        "workspaceId": "workspace-a",
        "baseId": "base-a",
        "resourceType": "base"
      },
      "operation": "base:manage_tokens",
      "requiredPermission": "base:manage_tokens",
      "frontendVisible": false,
      "expected": {
        "status": 403,
        "failureClass": "authorization"
      }
    },
    {
      "id": "authorized-user-succeeds",
      "description": "An active user with permission succeeds",
      "actor": {
        "state": "active",
        "role": "owner",
        "permissions": ["base:manage_tokens"]
      },
      "target": {
        "workspaceId": "workspace-a",
        "baseId": "base-a",
        "resourceType": "base"
      },
      "operation": "base:manage_tokens",
      "requiredPermission": "base:manage_tokens",
      "frontendVisible": true,
      "expected": {
        "status": 200,
        "failureClass": "success"
      }
    },
