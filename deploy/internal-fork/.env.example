# Copy to .env.internal at the repository root for local overrides.
# Do not commit the copied file.
NC_INTERNAL_EXTENSIONS_ENABLED=true
NC_INTERNAL_ADMIN_ENABLED=true
NC_INTERNAL_FINE_GRAINED_API_TOKENS_ENABLED=true
NC_INTERNAL_BASE_PERMISSIONS_ENABLED=true
NC_INTERNAL_INPUT_VALIDATION_ENABLED=true
NC_INTERNAL_DOCUMENT_PERMISSIONS_ENABLED=true
NC_INTERNAL_FILE_PREVIEW_MODE_ENABLED=true
NC_INTERNAL_DISCUSSION_MODE_ENABLED=true

# File preview requires secure, authorization-bound attachment URLs.
NC_SECURE_ATTACHMENTS=true

# Optional tuning.
NC_INTERNAL_DOCUMENT_REVISION_RETENTION=100
NC_INTERNAL_TOKEN_AUTH_FAILURES_PER_MINUTE=30
NC_DISABLE_TELE=true

# For a shared deployment, use PostgreSQL and secrets supplied by your
# environment/secrets manager. Leave unset for NocoDB's local SQLite default.
# NC_DB=pg://database.example:5432?u=nocodb&p=REPLACE_ME&d=nocodb
# NC_REDIS_URL=redis://redis.example:6379/0
# NC_AUTH_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
